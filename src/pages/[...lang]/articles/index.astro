---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return [
		{ params: { lang: undefined } },
		{ params: { lang: 'pt' } },
	];
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const posts = (await getCollection('articles'))
	.filter((post) => post.id.startsWith(currentLang + '/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = currentLang === 'en' ? 'Technical Publications' : 'Publicações Técnicas';
const noPosts = currentLang === 'en' ? 'No posts available at the moment.' : 'Nenhuma publicação disponível de momento.';
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			section {
				margin-top: 3rem;
			}
			article {
				margin-top: 2rem;
			}
			article:not(:last-child) {
				margin-bottom: 3rem;
			}
			a.post-link {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1.5rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			a.post-link:hover .title {
				color: var(--accent);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0.75rem 0 0 0;
			}
			.post-tags a {
				display: inline-block;
				padding: 0.15rem 0.55rem;
				font-size: 0.75rem;
				font-weight: 500;
				color: var(--accent-dark);
				background-color: rgb(var(--gray-light));
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				text-decoration: none;
				transition: all 0.15s ease;
			}
			.post-tags a:hover {
				color: #fff;
				background-color: var(--accent);
				border-color: var(--accent);
			}
			.tile-cover {
				display: block;
				margin-top: 1rem;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgb(var(--border));
				background-color: rgb(var(--gray-light));
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.tile-cover img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
			}
			a.post-link:hover ~ .tile-cover {
				border-color: var(--accent);
				transform: translateY(-2px);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<section>
				{posts.length > 0 ? (
					posts.map((post) => {
						const slug = post.id.split('/').slice(1).join('/');
						const href = currentLang === 'en' ? `/articles/${slug}/` : `/pt/articles/${slug}/`;
						const tags = post.data.tags || [];
						return (
							<article>
								<a href={href} class="post-link">
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
								{post.data.heroImage && (
									<a href={href} class="tile-cover" aria-hidden="true" tabindex="-1">
										<img src={post.data.heroImage.src} alt="" width={1200} height={630} loading="lazy" />
									</a>
								)}
								<p>{post.data.description}</p>
								{tags.length > 0 && (
									<nav class="post-tags" aria-label="Tags">
										{tags.map((tag) => {
											const tagHref = currentLang === 'en' ? `/tags/${tag}/` : `/pt/tags/${tag}/`;
											return <a href={tagHref}>#{tag}</a>;
										})}
									</nav>
								)}
							</article>
						);
					})
				) : (
					<p>{noPosts}</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
