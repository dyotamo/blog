---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return [
		{ params: { lang: undefined } },
		{ params: { lang: 'pt' } },
	];
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const posts = (await getCollection('articles')).filter((post) =>
	post.id.startsWith(currentLang + '/'),
);

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags || []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()].sort((a, b) => {
	if (b[1] !== a[1]) return b[1] - a[1];
	return a[0].localeCompare(b[0]);
});

const title = currentLang === 'en' ? 'Browse by Tag' : 'Procurar por Tag';
const subtitle =
	currentLang === 'en'
		? 'All topics covered across publications, ordered by frequency.'
		: 'Todos os tópicos cobertos nas publicações, ordenados por frequência.';
const empty = currentLang === 'en' ? 'No tags yet.' : 'Ainda não há tags.';
const postWord = (n: number) =>
	currentLang === 'en' ? (n === 1 ? 'post' : 'posts') : n === 1 ? 'publicação' : 'publicações';
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.lead {
				margin-top: 0.5rem;
				color: rgb(var(--gray));
			}
			.tag-grid {
				margin-top: 2.5rem;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1rem;
			}
			a.tag-card {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1rem 1.25rem;
				color: var(--accent-dark);
				background-color: rgb(var(--gray-light));
				border: 1px solid rgb(var(--border));
				border-radius: 12px;
				text-decoration: none;
				font-weight: 600;
				transition: all 0.15s ease;
			}
			a.tag-card:hover {
				color: #fff;
				background-color: var(--accent);
				border-color: var(--accent);
			}
			a.tag-card .count {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				background-color: rgb(var(--background));
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				border: 1px solid rgb(var(--border));
			}
			a.tag-card:hover .count {
				color: var(--accent-dark);
				border-color: rgba(255, 255, 255, 0.4);
				background-color: rgba(255, 255, 255, 0.95);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p class="lead">{subtitle}</p>
			{tags.length > 0 ? (
				<div class="tag-grid">
					{tags.map(([tag, count]) => {
						const href = currentLang === 'en' ? `/tags/${tag}/` : `/pt/tags/${tag}/`;
						return (
							<a class="tag-card" href={href}>
								<span>#{tag}</span>
								<span class="count">{count} {postWord(count)}</span>
							</a>
						);
					})}
				</div>
			) : (
				<p>{empty}</p>
			)}
		</main>
		<Footer />
	</body>
</html>
