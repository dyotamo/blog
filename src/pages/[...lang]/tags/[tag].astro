---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const langs: Array<'en' | 'pt'> = ['en', 'pt'];
	const allPaths: Array<{
		params: { lang?: string; tag: string };
		props: { tag: string; lang: 'en' | 'pt' };
	}> = [];

	for (const lang of langs) {
		const posts = (await getCollection('blog')).filter((post) =>
			post.id.startsWith(lang + '/'),
		);
		const tagSet = new Set<string>();
		for (const post of posts) {
			for (const tag of post.data.tags || []) {
				tagSet.add(tag);
			}
		}
		for (const tag of tagSet) {
			allPaths.push({
				params: { lang: lang === 'en' ? undefined : lang, tag },
				props: { tag, lang },
			});
		}
	}
	return allPaths;
}

type Props = { tag: string; lang: 'en' | 'pt' };

const { tag, lang } = Astro.props as Props;
const currentLang = lang;

const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith(currentLang + '/'))
	.filter((post) => (post.data.tags || []).includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = currentLang === 'en' ? `Tag: #${tag}` : `Tag: #${tag}`;
const subtitle =
	currentLang === 'en'
		? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} filed under this tag.`
		: `${posts.length} ${posts.length === 1 ? 'publicação' : 'publicações'} com esta tag.`;
const empty =
	currentLang === 'en'
		? 'No posts found for this tag.'
		: 'Nenhuma publicação encontrada para esta tag.';
const allTagsLabel = currentLang === 'en' ? 'All tags' : 'Todas as tags';
const allTagsHref = currentLang === 'en' ? '/tags/' : '/pt/tags/';

const otherTags = new Map<string, number>();
const allLangPosts = (await getCollection('blog')).filter((post) =>
	post.id.startsWith(currentLang + '/'),
);
for (const post of allLangPosts) {
	for (const t of post.data.tags || []) {
		if (t !== tag) otherTags.set(t, (otherTags.get(t) ?? 0) + 1);
	}
}
const relatedTags = [...otherTags.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.back-link {
				display: inline-block;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
			}
			.lead {
				color: rgb(var(--gray));
				margin-top: 0.5rem;
			}
			section.posts {
				margin-top: 2.5rem;
			}
			section.posts article {
				margin-top: 1.5rem;
			}
			section.posts article:not(:last-child) {
				margin-bottom: 2.5rem;
			}
			a.post-link {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1.4rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			a.post-link:hover .title {
				color: var(--accent);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0.75rem 0 0 0;
			}
			.post-tags a {
				display: inline-block;
				padding: 0.15rem 0.55rem;
				font-size: 0.75rem;
				font-weight: 500;
				color: var(--accent-dark);
				background-color: rgb(var(--gray-light));
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				text-decoration: none;
				transition: all 0.15s ease;
			}
			.post-tags a:hover {
				color: #fff;
				background-color: var(--accent);
				border-color: var(--accent);
			}
			.related {
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related h3 {
				margin-bottom: 0.75rem;
			}
			.related .post-tags a {
				font-size: 0.85rem;
				padding: 0.3rem 0.7rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href={allTagsHref}>← {allTagsLabel}</a>
			<h1>{title}</h1>
			<p class="lead">{subtitle}</p>

			<section class="posts">
				{posts.length > 0 ? (
					posts.map((post) => {
						const slug = post.id.split('/').slice(1).join('/');
						const href = currentLang === 'en' ? `/blog/${slug}/` : `/pt/blog/${slug}/`;
						const tags = post.data.tags || [];
						return (
							<article>
								<a href={href} class="post-link">
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
								<p>{post.data.description}</p>
								{tags.length > 0 && (
									<nav class="post-tags" aria-label="Tags">
										{tags.map((t) => {
											const tagHref = currentLang === 'en' ? `/tags/${t}/` : `/pt/tags/${t}/`;
											return <a href={tagHref}>#{t}</a>;
										})}
									</nav>
								)}
							</article>
						);
					})
				) : (
					<p>{empty}</p>
				)}
			</section>

			{relatedTags.length > 0 && (
				<section class="related">
					<h3>{currentLang === 'en' ? 'Related tags' : 'Tags relacionadas'}</h3>
					<nav class="post-tags" aria-label="Related tags">
						{relatedTags.map(([t]) => {
							const href = currentLang === 'en' ? `/tags/${t}/` : `/pt/tags/${t}/`;
							return <a href={href}>#{t}</a>;
						})}
					</nav>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
