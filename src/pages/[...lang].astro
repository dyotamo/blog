---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

export async function getStaticPaths() {
	return [
		{ params: { lang: undefined } },
		{ params: { lang: 'pt' } },
	];
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith(currentLang + '/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);

const content = {
	en: {
		title: 'Engineering Insights & System Design',
		bio: 'I\'m <strong>Dássone J. Yotamo</strong>, a software developer who likes programming languages, distributed systems, cloud, and Linux environments.',
		platform: 'On this blog I share thoughts and ideas about the technical things I use every day.',
		explore: 'Explore the <a href="/blog">posts</a> or check out the latest below.',
		latest: 'Latest Posts',
		noPosts: 'No posts yet. Stay tuned!',
	},
	pt: {
		title: 'Engenharia & Design de Sistemas',
		bio: 'Sou o <strong>Dássone J. Yotamo</strong>, um desenvolvedor de software que gosta de linguagens de programação, sistemas distribuídos, cloud e ambientes Linux.',
		platform: 'Neste blog partilho pensamentos e ideias sobre as coisas técnicas que uso no dia a dia.',
		explore: 'Explore as <a href="/pt/blog">publicações</a> ou veja as últimas abaixo.',
		latest: 'Últimas Publicações',
		noPosts: 'Ainda não há publicações. Fique atento!',
	},
};

const t = content[currentLang as keyof typeof content];
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{t.title}</h1>
			<p set:html={t.bio} />
			<p>{t.platform}</p>
			<p set:html={t.explore} />

			{latestPosts.length > 0 ? (
				<section class="latest-posts">
					<h2>{t.latest}</h2>
					{latestPosts.map((post) => {
						const slug = post.id.split('/').slice(1).join('/');
						const href = currentLang === 'en' ? `/blog/${slug}/` : `/pt/blog/${slug}/`;
						const tags = post.data.tags || [];
						return (
							<article>
								<a href={href}>
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
								<p>{post.data.description}</p>
								{tags.length > 0 && (
									<nav class="post-tags" aria-label="Tags">
										{tags.map((tag) => {
											const tagHref = currentLang === 'en' ? `/tags/${tag}/` : `/pt/tags/${tag}/`;
											return <a href={tagHref}>#{tag}</a>;
										})}
									</nav>
								)}
							</article>
						);
					})}
				</section>
			) : (
				<section class="latest-posts">
					<p>{t.noPosts}</p>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.latest-posts {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.latest-posts article {
		margin-top: 2rem;
	}
	.latest-posts article:not(:last-child) {
		margin-bottom: 3rem;
	}
	.latest-posts a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.latest-posts .title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1.2;
		font-size: 1.5rem;
	}
	.latest-posts .date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.latest-posts a:hover .title {
		color: var(--accent);
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.5rem 0 0 0;
	}
	.post-tags a {
		display: inline-block;
		padding: 0.15rem 0.55rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--accent-dark);
		background-color: rgb(var(--gray-light));
		border: 1px solid rgb(var(--border));
		border-radius: 999px;
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.post-tags a:hover {
		color: #fff;
		background-color: var(--accent);
		border-color: var(--accent);
	}
</style>
