---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'articles'>['data'];

const { title, description, pubDate, updatedDate, tags, heroImage } = Astro.props;
const { pathname } = Astro.url;
const isPt = pathname.startsWith('/pt/') || pathname === '/pt';
const tagsLabel = isPt ? 'Tags' : 'Tags';
---

<html lang={isPt ? 'pt' : 'en'}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				justify-content: center;
				margin: 0.5rem 0 1.5rem 0;
			}
			.post-tags a {
				display: inline-block;
				padding: 0.25rem 0.7rem;
				font-size: 0.8rem;
				font-weight: 500;
				color: var(--accent-dark);
				background-color: rgb(var(--gray-light));
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				text-decoration: none;
				transition: all 0.15s ease;
			}
			.post-tags a:hover {
				color: #fff;
				background-color: var(--accent);
				border-color: var(--accent);
			}
			.post-hero {
				display: block;
				margin: 1.5em auto;
				max-width: 900px;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgb(var(--border));
				background-color: rgb(var(--gray-light));
			}
			.post-hero img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<figure class="post-hero">
						<img src={heroImage.src} alt={title} width={1200} height={630} />
					</figure>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{isPt ? 'Última atualização em' : 'Last updated on'}{' '}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							tags && tags.length > 0 && (
								<nav class="post-tags" aria-label={tagsLabel}>
									{tags.map((tag) => {
										const href = isPt ? `/pt/tags/${tag}/` : `/tags/${tag}/`;
										return (
											<a href={href}>#{tag}</a>
										);
									})}
								</nav>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
		<script is:inline>
			// Transform Shiki-highlighted mermaid blocks into raw div.mermaid
			const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
			mermaidBlocks.forEach((block) => {
				const div = document.createElement('div');
				div.className = 'mermaid';
				div.textContent = block.textContent;
				block.parentNode.replaceChild(div, block);
			});

			mermaid.initialize({ startOnLoad: true, theme: 'default' });
		</script>
	</body>
</html>
