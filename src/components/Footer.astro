---
const today = new Date();
const { pathname } = Astro.url;
const isPt = pathname.startsWith('/pt/') || pathname === '/pt';
---

<footer>
	<div class="container">
		<p>&copy; {today.getFullYear()} Dássone J. Yotamo. {isPt ? 'Todos os direitos reservados.' : 'All rights reserved.'}</p>
		<div class="social-links">
			<a href="https://x.com/dyotamo007" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Follow Dássone on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path fill="currentColor" d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.055-4.425 5.055H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"></path>
				</svg>
			</a>
			<a href="https://github.com/dyotamo" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Go to Dássone's GitHub profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 4rem 1.5rem;
		background: rgb(var(--background));
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--gray));
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}
	.container {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}
	footer p {
		margin: 0;
		font-size: 0.9rem;
	}
	.social-links {
		display: flex;
		gap: 1.5rem;
	}
	.social-links a {
		color: rgb(var(--gray));
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
