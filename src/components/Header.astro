---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeIcon from './ThemeIcon.astro';
import LanguagePicker from './LanguagePicker.astro';

const { pathname } = Astro.url;
const isPt = pathname.startsWith('/pt/') || pathname === '/pt';
const langPrefix = isPt ? '/pt' : '';
---

<header>
	<nav>
		<a href={langPrefix || '/'} class="brand">
			{isPt ? 'Início' : 'Home'}
		</a>
		<div class="nav-content">
			<div class="internal-links">
				<HeaderLink href={`${langPrefix}/articles`}>Articles</HeaderLink>
			</div>
			<div class="controls">
				<LanguagePicker />
				<ThemeIcon />
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: rgba(var(--background), 0.8);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(var(--border), 0.5);
		position: sticky;
		top: 0;
		z-index: 10;
		transition: all 0.3s ease;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 4rem;
	}
	.brand {
		font-size: 1.25rem;
		font-weight: 700;
		text-decoration: none;
		color: rgb(var(--black));
		letter-spacing: -0.02em;
		transition: opacity 0.2s ease;
	}
	.brand:hover {
		opacity: 0.8;
	}
	.nav-content {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-left: 1px solid rgba(var(--border), 0.5);
		padding-left: 1.25rem;
		margin-left: 0.5rem;
	}
	nav a:not(.brand) {
		padding: 0.5rem 0.875rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		border-radius: 0.5rem;
		transition: all 0.2s ease;
		border-bottom: none;
	}
	nav a:not(.brand).active {
		color: var(--accent);
		background: rgba(var(--gray-light), 0.5);
	}
	:root.dark nav a:not(.brand).active {
		background: rgba(var(--gray-light), 0.1);
	}
	nav a:not(.brand):hover {
		color: var(--accent);
		background: rgba(var(--gray-light), 0.3);
	}
	:root.dark nav a:not(.brand):hover {
		background: rgba(var(--gray-light), 0.05);
	}
</style>
